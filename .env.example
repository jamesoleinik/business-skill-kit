# Copy to .env and fill in. Never commit .env.
# The Dataverse environment the skills run against.
DATAVERSE_URL=https://<your-env>.crm.dynamics.com

# Reuse an existing auth profile name; skills never do an interactive sign-in.
DATAVERSE_AUTH_PROFILE=<your-profile>

# Windows: keep JSON and emoji from crashing the console.
PYTHONIOENCODING=utf-8
