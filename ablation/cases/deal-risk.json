  "cases": [
    {
      "id": "dr-rank-risk",
      "query": "Which open deals are most at risk?",
      "assertions": [
        {"level": "critical", "kind": "ranked_first", "dataset": "ranked", "by": "risk", "idfield": "id", "id": "O003"},
        {"level": "expected", "kind": "contains", "dataset": "at_risk", "idfield": "id", "id": "O002"},
        {"level": "expected", "kind": "not_contains", "dataset": "at_risk", "idfield": "id", "id": "O001"}
      ]
    }
  ]
