{
  "skill": "sales/deal-risk",
  "description": "Rank open opportunities by risk with an explained score.",
  "with": {
    "module": "skills/sales/deal-risk/skill.py",
    "args": {"threshold": 40, "today": "2026-09-01"},
    "datasets": {"ranked": "ranked", "at_risk": "at_risk"}
  },
  "without": {
    "text": "Here is the open pipeline.",
    "datasets": {"ranked": {"source": "table", "table": "opportunity"}, "at_risk": {"source": "empty"}}
